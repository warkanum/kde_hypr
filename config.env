TERM_CMD=kitty
BROWSER_CMD=firefox
FILES_CMD=dolphin
SCRATCH_CMD="kitty --class hypr-scratch"   # must set window class hypr-scratch
DESKTOPS=9
MOD_KEY=Meta                               # mouse modifier: Mod+LMB move, Mod+RMB resize
KEYSTYLE=arrows                            # arrows | vim  (focus = Mod+dir, tile = Mod+Shift+dir)
